# Variables de entorno — NikonCoach
# Copiá este archivo como .env y rellenalo con tus credenciales
# NUNCA subas el .env al repositorio Git

APP_ENV=local
APP_NAME=NikonCoach
APP_URL=http://localhost:8088

# ── Google Gemini API ────────────────────────────────
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# ── Observabilidad (Opcional) ────────────────────────
SENTRY_DSN=

# ── Hostinger VPS Deploy ─────────────────────────────
VPS_HOST=tu_host_vps
VPS_PORT=22
VPS_USER=tu_usuario_vps
VPS_PASS=tu_password_vps
VPS_REMOTE_PATH=domains/tu-dominio.com/public_html/NikonCoach

