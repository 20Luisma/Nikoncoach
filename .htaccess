<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acceso a archivos sensibles
    RewriteRule ^\.env - [F,L]
    RewriteRule ^\.git - [F,L]
    RewriteRule ^src/ - [F,L]
    RewriteRule ^templates/ - [F,L]
    RewriteRule ^bin/ - [F,L]
    RewriteRule ^docs/ - [F,L]

    # Redirigir la raíz hacia public/
    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Evitar cache en archivos que cambian dinámicamente (PWA, scripts, estilos)
<FilesMatch "\.(json|js|css|html|php)$">
    FileETag None
    <IfModule mod_headers.c>
        Header unset ETag
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </IfModule>
</FilesMatch>

# Permitir a Google WebAPK server descargar iconos para empaquetar la app en Android sin cache
<FilesMatch "\.(png|svg|ico)$">
    FileETag None
    <IfModule mod_headers.c>
        Header set Access-Control-Allow-Origin "*"
        Header unset ETag
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </IfModule>
</FilesMatch>
