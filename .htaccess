<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acceso a archivos sensibles
    RewriteRule ^\.env - [F,L]
    RewriteRule ^\.git - [F,L]
    RewriteRule ^src/ - [F,L]
    RewriteRule ^templates/ - [F,L]
    RewriteRule ^bin/ - [F,L]
    RewriteRule ^docs/ - [F,L]

    # Redirigir todo hacia public/
    RewriteRule ^$ public/ [L]
    RewriteRule ^((?!public).*)$ public/$1 [L,NC]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

